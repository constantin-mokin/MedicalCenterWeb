@model MedicalCenterWeb.Models.DoctorAppointmentsViewModel
@using MedicalCenterWeb.Models
@{
    ViewData["Title"] = "Мои приёмы";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<div class="card mb-4"><div class="card-title">Врач: @(Model.Doctor.User?.FirstName) @(Model.Doctor.User?.LastName) — @Model.Doctor.Specialization</div>
    @if (!string.IsNullOrEmpty(Model.Doctor.Bio))
    {
        <p class="text-muted" style="font-size:.85rem">@Model.Doctor.Bio</p>
    }
</div>
<div class="search-bar no-print"><form method="get" style="display:flex;gap:10px;flex:1"><input type="text" name="search" class="form-control" placeholder="Поиск пациента..." value="@Model.Search" /><button type="submit" class="btn btn-outline">Найти</button></form></div>
<div class="card">
    <div class="card-title">Расписание приёмов</div>
    <div class="table-wrap"><table><thead><tr><th>Пациент</th><th>Процедура</th><th>Дата и время</th><th>Статус</th><th>Действия</th></tr></thead><tbody>
    @foreach (var a in Model.Appointments)
    {
        <tr>
            <td class="fw-600">@(a.Patient?.FirstName) @(a.Patient?.LastName)</td>
            <td>@a.Procedure?.Name</td>
            <td>@a.AppointmentDateTime.ToString("dd.MM.yyyy HH:mm")</td>
            <td><span class="status-badge @a.Status.StatusCss()">@a.Status.StatusText()</span></td>
            <td><div class="btn-group">
                @if (a.Status == AppointmentStatus.Scheduled)
                {
                    <form asp-action="MarkCompleted" asp-route-id="@a.Id" method="post" onsubmit="return confirm('Пометить выполненным?')"><button type="submit" class="btn btn-sm btn-success">Выполнен</button></form>
                }
                <a asp-controller="MedicalRecord" asp-action="Edit" asp-route-appointmentId="@a.Id" class="btn btn-sm btn-primary">Медкарта</a>
            </div></td>
        </tr>
    }
    @if (Model.Appointments.Count == 0)
    {
        <tr><td colspan="5" class="text-center text-muted">Приёмов не найдено</td></tr>
    }
    </tbody></table></div>
    @if (Model.TotalPages > 1)
    {
        <div class="pagination">@{for (var i = 1; i <= Model.TotalPages; i++){ if (i == Model.CurrentPage){<span class="active">@i</span>}else{<a href="?page=@i&search=@Model.Search">@i</a>} }}</div>
    }
</div>
