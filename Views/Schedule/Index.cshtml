@model MedicalCenterWeb.Models.ScheduleIndexViewModel
@{
    ViewData["Title"] = "Расписание врачей";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var days = new[] { "Понедельник", "Вторник", "Среда", "Четверг", "Пятница", "Суббота", "Воскресенье" };
}
<div class="card">
    <div class="card-title">Расписание врачей</div>
    <div class="form-group" style="max-width:400px"><label>Выберите врача</label><select id="doctorSelect" class="form-control" onchange="loadSchedules()"><option value="">— Выберите врача —</option>@foreach (var d in Model.Doctors){<option value="@d.Id">@(d.User?.LastName) @(d.User?.FirstName) — @d.Specialization</option>}</select></div>
    <div id="addScheduleBlock" style="display:none" class="card mt-4 no-print">
        <h3 style="margin-bottom:16px">Добавить расписание</h3>
        <form asp-action="Add" method="post">
            <div class="grid-2">
                <div class="form-group"><label>День недели</label><select name="dayOfWeek" class="form-control">@for (var i = 0; i < 7; i++){<option value="@i">@days[i]</option>}</select></div>
                <div></div>
                <div class="form-group"><label>Начало</label><input type="time" name="startTime" class="form-control" value="09:00" required /></div>
                <div class="form-group"><label>Конец</label><input type="time" name="endTime" class="form-control" value="17:00" required /></div>
            </div>
            <input type="hidden" id="doctorIdInput" name="doctorId" />
            <button type="submit" class="btn btn-success mt-4">Добавить</button>
        </form>
    </div>
    <div id="scheduleTable" class="mt-4"></div>
</div>

<div id="afTokenHolder" class="no-print" style="display:none">@Html.AntiForgeryToken()</div>

<div id="editScheduleModal" class="modal-overlay" style="display:none" onclick="if(event.target===this)this.style.display='none'">
    <div class="modal">
        <h2>Редактирование расписания</h2>
        <form action="/Schedule/Update" method="post">
            <input type="hidden" id="editSchedId" name="id" />
            <div class="form-group"><label>День недели</label><select id="editSchedDay" name="dayOfWeek" class="form-control">@for (var i = 0; i < 7; i++){<option value="@i">@days[i]</option>}</select></div>
            <div class="grid-2">
                <div class="form-group"><label>Начало</label><input type="time" id="editSchedStart" name="startTime" class="form-control" required /></div>
                <div class="form-group"><label>Конец</label><input type="time" id="editSchedEnd" name="endTime" class="form-control" required /></div>
            </div>
            <div class="btn-group mt-4">
                <button type="submit" class="btn btn-success">Сохранить</button>
                <button type="button" class="btn btn-danger" onclick="document.getElementById('editScheduleModal').style.display='none'">Отмена</button>
            </div>
        </form>
    </div>
</div>

@section Scripts{
<script>
var urlScheduleDelete = '@Url.Action("Delete", "Schedule")';
var afTokenInput = document.querySelector('#afTokenHolder input[name="__RequestVerificationToken"]');
var afToken = afTokenInput ? afTokenInput.value : '';

function loadSchedules(){
    var docId = document.getElementById('doctorSelect').value;
    var ab = document.getElementById('addScheduleBlock');
    var td = document.getElementById('scheduleTable');
    if (!docId) { ab.style.display = 'none'; td.innerHTML = ''; return; }
    document.getElementById('doctorIdInput').value = docId;
    ab.style.display = 'block';
    fetch('/Schedule/GetSchedules?doctorId=' + docId)
        .then(r => r.json())
        .then(function(data){
            if (!data.length) { td.innerHTML = '<p class="text-muted">Расписание не задано</p>'; return; }
            var days = ['Воскресенье','Понедельник','Вторник','Среда','Четверг','Пятница','Суббота'];
            var h = '<div class="table-wrap"><table><thead><tr><th>День</th><th>Начало</th><th>Конец</th><th>Действия</th></tr></thead><tbody>';
            data.forEach(function(s){
                h += '<tr>'
                   + '<td class="fw-600">' + days[s.dayOfWeek] + '</td>'
                   + '<td>' + s.startTime.substring(0,5) + '</td>'
                   + '<td>' + s.endTime.substring(0,5) + '</td>'
                   + '<td><div class="btn-group">'
                   + '<button type="button" class="btn btn-sm btn-primary" onclick="editSchedule(' + s.id + ', ' + s.dayOfWeek + ', \'' + s.startTime.substring(0,5) + '\', \'' + s.endTime.substring(0,5) + '\')">Изменить</button>'
                   + '<form action="' + urlScheduleDelete + '" method="post" onsubmit="return confirm(\'Удалить?\')">'
                   + '<input type="hidden" name="id" value="' + s.id + '" />'
                   + '<input type="hidden" name="__RequestVerificationToken" value="' + afToken + '" />'
                   + '<button type="submit" class="btn btn-sm btn-danger">Удалить</button></form>'
                   + '</div></td></tr>';
            });
            h += '</tbody></table></div>';
            td.innerHTML = h;
        });
}

function editSchedule(id, dayOfWeek, startTime, endTime){
    document.getElementById('editSchedId').value = id;
    document.getElementById('editSchedDay').value = dayOfWeek;
    document.getElementById('editSchedStart').value = startTime;
    document.getElementById('editSchedEnd').value = endTime;
    var form = document.querySelector('#editScheduleModal form');
    if (!form.querySelector('input[name="__RequestVerificationToken"]')) {
        var t = document.createElement('input');
        t.type = 'hidden';
        t.name = '__RequestVerificationToken';
        t.value = afToken;
        form.appendChild(t);
    }
    document.getElementById('editScheduleModal').style.display = 'flex';
}
</script>
}
