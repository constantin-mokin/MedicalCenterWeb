@using Microsoft.AspNetCore.Authorization
@using MedicalCenterWeb.Models
@using MedicalCenterWeb.Services
@inject IAuthorizationService AuthZ
@{
    var userName = User.Identity?.Name;
    var role = User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value;
}
<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@Strings.AppName — @ViewBag.Title</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header class="header">
        <div class="header-inner">
            <a class="logo" href="/">
                <svg viewBox="0 0 24 24"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/></svg>
                @Strings.AppName
            </a>
            <button class="menu-btn" onclick="document.querySelector('.nav').classList.toggle('open')">
                <span></span><span></span><span></span>
            </button>
            <nav class="nav">
                @if (User.Identity?.IsAuthenticated == true)
                {
                    @if (role == "Admin")
                    {
                        <a asp-controller="Admin" asp-action="Index"><svg viewBox="0 0 24 24"><path d="M3 13h8V3H3v10zm0 8h8v-6H3v6zm10 0h8V11h-8v10zm0-18v6h8V3h-8z"/></svg> @Strings.NavHome</a>
                        <a asp-controller="Admin" asp-action="Doctors"><svg viewBox="0 0 24 24"><path d="M16 11c1.66 0 2.99-1.34 2.99-3S17.66 5 16 5c-1.66 0-3 1.34-3 3s1.34 3 3 3zm-8 0c1.66 0 2.99-1.34 2.99-3S9.66 5 8 5C6.34 5 5 6.34 5 8s1.34 3 3 3zm0 2c-2.33 0-7 1.17-7 3.5V19h14v-2.5c0-2.33-4.67-3.5-7-3.5zm8 0c-.29 0-.62.02-.97.05 1.16.84 1.97 1.97 1.97 3.45V19h6v-2.5c0-2.33-4.67-3.5-7-3.5z"/></svg> @Strings.NavDoctors</a>
                        <a asp-controller="Admin" asp-action="Procedures"><svg viewBox="0 0 24 24"><path d="M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm-2 10h-4v4h-2v-4H7v-2h4V7h2v4h4v2z"/></svg> @Strings.NavProcedures</a>
                        <a asp-controller="Staff" asp-action="Patients"><svg viewBox="0 0 24 24"><path d="M16 11c1.66 0 2.99-1.34 2.99-3S17.66 5 16 5c-1.66 0-3 1.34-3 3s1.34 3 3 3zm-8 0c1.66 0 2.99-1.34 2.99-3S9.66 5 8 5C6.34 5 5 6.34 5 8s1.34 3 3 3zm0 2c-2.33 0-7 1.17-7 3.5V19h14v-2.5c0-2.33-4.67-3.5-7-3.5z"/></svg> @Strings.NavPatients</a>
                        <a asp-controller="Staff" asp-action="Appointments"><svg viewBox="0 0 24 24"><path d="M19 3h-1V1h-2v2H8V1H6v2H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm0 16H5V8h14v11zM9 10H7v2h2v-2zm4 0h-2v2h2v-2zm4 0h-2v2h2v-2z"/></svg> @Strings.NavAppointments</a>
                        <a asp-controller="Schedule" asp-action="Index"><svg viewBox="0 0 24 24"><path d="M11.99 2C6.47 2 2 6.48 2 12s4.47 10 9.99 10C17.52 22 22 17.52 22 12S17.52 2 11.99 2zM12 20c-4.42 0-8-3.58-8-8s3.58-8 8-8 8 3.58 8 8-3.58 8-8 8zm.5-13H11v6l5.25 3.15.75-1.23-4.5-2.67z"/></svg> @Strings.NavSchedule</a>
                        <a asp-controller="Stats" asp-action="Index"><svg viewBox="0 0 24 24"><path d="M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zM9 17H7v-7h2v7zm4 0h-2V7h2v10zm4 0h-2v-4h2v4z"/></svg> @Strings.NavReports</a>
                        <a asp-controller="Admin" asp-action="Users"><svg viewBox="0 0 24 24"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 3c1.66 0 3 1.34 3 3s-1.34 3-3 3-3-1.34-3-3 1.34-3 3-3zm0 14.2c-2.5 0-4.71-1.28-6-3.22.03-1.99 4-3.08 6-3.08 1.99 0 5.97 1.09 6 3.08-1.29 1.94-3.5 3.22-6 3.22z"/></svg> @Strings.NavUsers</a>
                        <a asp-controller="AuditLog" asp-action="Index"><svg viewBox="0 0 24 24"><path d="M14 2H6c-1.1 0-2 .9-2 2v16c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V8l-6-6zm2 16H8v-2h8v2zm0-4H8v-2h8v2zm-3-5V3.5L18.5 9H13z"/></svg> @Strings.NavAuditLog</a>
                    }
                    else if (role == "Doctor")
                    {
                        <a asp-controller="Doctor" asp-action="Index"><svg viewBox="0 0 24 24"><path d="M19 3h-1V1h-2v2H8V1H6v2H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm0 16H5V8h14v11zM9 10H7v2h2v-2zm4 0h-2v2h2v-2zm4 0h-2v2h2v-2z"/></svg> @Strings.NavMyAppointments</a>
                    }
                    else if (role == "Staff")
                    {
                        <a asp-controller="Staff" asp-action="Index"><svg viewBox="0 0 24 24"><path d="M3 13h8V3H3v10zm0 8h8v-6H3v6zm10 0h8V11h-8v10zm0-18v6h8V3h-8z"/></svg> @Strings.NavHome</a>
                        <a asp-controller="Staff" asp-action="Patients"><svg viewBox="0 0 24 24"><path d="M16 11c1.66 0 2.99-1.34 2.99-3S17.66 5 16 5c-1.66 0-3 1.34-3 3s1.34 3 3 3zm-8 0c1.66 0 2.99-1.34 2.99-3S9.66 5 8 5C6.34 5 5 6.34 5 8s1.34 3 3 3zm0 2c-2.33 0-7 1.17-7 3.5V19h14v-2.5c0-2.33-4.67-3.5-7-3.5z"/></svg> @Strings.NavPatients</a>
                        <a asp-controller="Staff" asp-action="Appointments"><svg viewBox="0 0 24 24"><path d="M19 3h-1V1h-2v2H8V1H6v2H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm0 16H5V8h14v11z"/></svg> @Strings.NavAppointments</a>
                    }
                }
            </nav>
            <div class="header-right">
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <span class="user-name">@userName</span>
                    <a asp-controller="Profile" asp-action="ChangePassword" title="@Strings.ChangePassword" class="theme-toggle" style="font-size:.85rem;text-decoration:none">🔑</a>
                    <button class="theme-toggle" onclick="toggleTheme()" title="@Strings.ThemeToggle">🌓</button>
                    <form asp-controller="Auth" asp-action="Logout" method="post" class="logout-form">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn-logout">@Strings.Logout</button>
                    </form>
                }
            </div>
        </div>
    </header>
    <main class="main">
        @RenderBody()
    </main>
    <footer class="footer">
        <p>
            @Strings.AppName — @Strings.FooterPhone<br/>
            &copy; @AppClock.Now.Year
        </p>
    </footer>
    @await RenderSectionAsync("Scripts", required: false)
    <div id="toastContainer"></div>
    <script>
    function showToast(message, type) {
        const container = document.getElementById('toastContainer');
        const toast = document.createElement('div');
        toast.className = 'toast toast-' + (type || 'success');
        const icons = { success: '✅', error: '❌', info: 'ℹ️' };
        toast.innerHTML = '<span class="toast-icon">' + (icons[type] || icons.success) + '</span><span class="toast-msg">' + message + '</span><span class="toast-close" onclick="this.parentElement.remove()">✕</span>';
        container.appendChild(toast);
        setTimeout(function() { toast.classList.add('toast-show'); }, 10);
        setTimeout(function() { toast.classList.remove('toast-show'); setTimeout(function() { toast.remove(); }, 400); }, 3500);
    }
    (function(){
        var msgs = @Html.Raw(Json.Serialize(new { s = TempData["Success"], e = TempData["Error"] }));
        if(msgs.s) showToast(msgs.s, 'success');
        if(msgs.e) showToast(msgs.e, 'error');
    })();
    function toggleTheme(){
        const t=document.documentElement.getAttribute('data-theme')==='dark'?'':'dark';
        document.documentElement.setAttribute('data-theme',t);
        localStorage.setItem('theme',t);
    }
    (function(){const t=localStorage.getItem('theme');if(t)document.documentElement.setAttribute('data-theme',t)})();
    function toggleForm(id){const el=document.getElementById(id);el.style.display=el.style.display==='none'?'block':'none'}
    </script>
</body>
</html>
