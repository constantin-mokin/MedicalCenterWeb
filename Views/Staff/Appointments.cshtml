@model MedicalCenterWeb.Models.AppointmentsPageViewModel
@using MedicalCenterWeb.Models
@{
    ViewData["Title"] = "Запись на приём";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<div class="card no-print">
    <div class="card-title">Новый приём</div>
    <form asp-action="AddAppointment" method="post"><div class="grid-2">
        <div class="form-group"><label>Пациент</label><select name="patientId" class="form-control" required><option value="">— Выберите —</option>@foreach (var p in Model.Patients){<option value="@p.Id">@p.LastName @p.FirstName</option>}</select></div>
        <div class="form-group"><label>Врач</label><select name="doctorId" class="form-control" required><option value="">— Выберите —</option>@foreach (var d in Model.Doctors){<option value="@d.Id">@(d.User?.LastName) @(d.User?.FirstName) — @d.Specialization</option>}</select></div>
        <div class="form-group"><label>Процедура</label><select name="procedureId" class="form-control" required><option value="">— Выберите —</option>@foreach (var pr in Model.Procedures){<option value="@pr.Id">@pr.Name (@pr.Price.ToString("N2") BYN)</option>}</select></div>
        <div></div>
        <div class="form-group"><label>Дата</label><input type="date" name="appointmentDate" class="form-control" required /></div>
        <div class="form-group"><label>Время</label><input type="time" name="appointmentTime" class="form-control" required /></div>
    </div><button type="submit" class="btn btn-success mt-4">Записать на приём</button></form>
</div>
<div class="card">
    <div class="card-title">Список приёмов</div>
    <div class="filter-row no-print">
        <form method="get" style="display:flex;gap:10px;flex-wrap:wrap;flex:1">
            <input type="text" name="search" class="form-control" style="max-width:200px" placeholder="Поиск пациента..." value="@Model.Search" />
            <select name="statusFilter" class="form-control" style="max-width:180px"><option value="" selected="@(Model.StatusFilter == null)">Все статусы</option><option value="0" selected="@(Model.StatusFilter == 0)">Запланирован</option><option value="1" selected="@(Model.StatusFilter == 1)">Выполнен</option></select>
            <select name="doctorFilter" class="form-control" style="max-width:200px"><option value="">Все врачи</option>@foreach (var d in Model.Doctors){<option value="@d.Id" selected="@(Model.DoctorFilter == d.Id)">@(d.User?.LastName) @(d.User?.FirstName)</option>}</select>
            <input type="date" name="dateFrom" class="form-control" style="max-width:160px" value="@Model.DateFrom?.ToString("yyyy-MM-dd")" />
            <input type="date" name="dateTo" class="form-control" style="max-width:160px" value="@Model.DateTo?.ToString("yyyy-MM-dd")" />
            <button type="submit" class="btn btn-outline">Фильтр</button>
        </form>
    </div>
    <div class="table-wrap"><table><thead><tr><th>Пациент</th><th>Врач</th><th>Процедура</th><th>Дата и время</th><th>Статус</th><th>Действия</th></tr></thead><tbody>
    @foreach (var a in Model.Appointments)
    {
        <tr>
            <td class="fw-600">@(a.Patient?.FirstName) @(a.Patient?.LastName)</td>
            <td>@(a.Doctor?.User?.FirstName) @(a.Doctor?.User?.LastName)</td>
            <td>@a.Procedure?.Name</td>
            <td>@a.AppointmentDateTime.ToString("dd.MM.yyyy HH:mm")</td>
            <td><span class="status-badge @a.Status.StatusCss()">@a.Status.StatusText()</span></td>
            <td><div class="btn-group">
                @if (User.IsInRole("Admin"))
                {
                    @if (a.Status == AppointmentStatus.Scheduled)
                    {
                        <form asp-action="MarkCompleted" asp-route-id="@a.Id" method="post" onsubmit="return confirm('Пометить выполненным?')"><button type="submit" class="btn btn-sm btn-success">Выполнен</button></form>
                    }
                    <a asp-controller="MedicalRecord" asp-action="Edit" asp-route-appointmentId="@a.Id" class="btn btn-sm btn-primary">Медкарта</a>
                }
                <button class="btn btn-sm btn-primary" onclick="editAppointment(@a.Id, @a.PatientId, @a.DoctorId, @a.ProcedureId, '@a.AppointmentDateTime.ToString("yyyy-MM-dd")', '@a.AppointmentDateTime.ToString("HH:mm")')">Изменить</button>
                <form asp-action="CancelAppointment" asp-route-id="@a.Id" method="post" onsubmit="return confirm('Отменить приём?')"><button type="submit" class="btn btn-sm btn-danger">Отменить</button></form>
            </div></td>
        </tr>
    }
    </tbody></table></div>
    @if (Model.TotalPages > 1)
    {
        <div class="pagination">@{for (var i = 1; i <= Model.TotalPages; i++){ if (i == Model.CurrentPage){<span class="active">@i</span>}else{<a href="?page=@i&search=@Model.Search&statusFilter=@Model.StatusFilter&doctorFilter=@Model.DoctorFilter&dateFrom=@Model.DateFrom?.ToString("yyyy-MM-dd")&dateTo=@Model.DateTo?.ToString("yyyy-MM-dd")">@i</a>} }}</div>
    }
</div>

<div id="editApptModal" class="modal-overlay" style="display:none" onclick="if(event.target===this)this.style.display='none'">
    <div class="modal">
        <h2>Редактирование приёма</h2>
        <form asp-action="UpdateAppointment" method="post">
            <input type="hidden" id="editApptId" name="id" />
            <div class="form-group"><label>Пациент</label><select id="editApptPatient" name="patientId" class="form-control" required>@foreach (var p in Model.Patients){<option value="@p.Id">@p.LastName @p.FirstName</option>}</select></div>
            <div class="form-group"><label>Врач</label><select id="editApptDoctor" name="doctorId" class="form-control" required>@foreach (var d in Model.Doctors){<option value="@d.Id">@(d.User?.LastName) @(d.User?.FirstName) — @d.Specialization</option>}</select></div>
            <div class="form-group"><label>Процедура</label><select id="editApptProcedure" name="procedureId" class="form-control" required>@foreach (var pr in Model.Procedures){<option value="@pr.Id">@pr.Name (@pr.Price.ToString("N2") BYN)</option>}</select></div>
            <div class="grid-2">
                <div class="form-group"><label>Дата</label><input type="date" id="editApptDate" name="appointmentDate" class="form-control" required /></div>
                <div class="form-group"><label>Время</label><input type="time" id="editApptTime" name="appointmentTime" class="form-control" required /></div>
            </div>
            <div class="btn-group mt-4">
                <button type="submit" class="btn btn-success">Сохранить</button>
                <button type="button" class="btn btn-danger" onclick="document.getElementById('editApptModal').style.display='none'">Отмена</button>
            </div>
        </form>
    </div>
</div>
@section Scripts{
<script>
function editAppointment(id, patientId, doctorId, procedureId, dateStr, timeStr){
    document.getElementById('editApptId').value = id;
    document.getElementById('editApptPatient').value = patientId;
    document.getElementById('editApptDoctor').value = doctorId;
    document.getElementById('editApptProcedure').value = procedureId;
    document.getElementById('editApptDate').value = dateStr;
    document.getElementById('editApptTime').value = timeStr;
    document.getElementById('editApptModal').style.display = 'flex';
}
</script>
}
