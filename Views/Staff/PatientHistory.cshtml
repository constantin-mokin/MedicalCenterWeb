@model MedicalCenterWeb.Models.PatientHistoryViewModel
@using MedicalCenterWeb.Models
@{
    ViewData["Title"] = "История пациента";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<div class="card mb-4">
    <div class="card-title">История пациента: @Model.Patient.LastName @Model.Patient.FirstName</div>
    <p>Телефон: @Model.Patient.Phone | Email: @(string.IsNullOrEmpty(Model.Patient.Email) ? "—" : Model.Patient.Email) | Дата рождения: @Model.Patient.DateOfBirth.ToString("dd.MM.yyyy") | Пол: @(Model.Patient.Gender == Gender.Male ? "Муж." : "Жен.")</p>
    @if (!string.IsNullOrEmpty(Model.Patient.MedicalHistory))
    {
        <p class="text-muted">Анамнез: @Model.Patient.MedicalHistory</p>
    }
</div>
<div class="card">
    <div class="card-title">Все приёмы (@Model.Appointments.Count)</div>
    <div class="table-wrap"><table><thead><tr><th>Дата</th><th>Врач</th><th>Процедура</th><th>Статус</th><th>Медкарта</th></tr></thead><tbody>
    @foreach (var a in Model.Appointments)
    {
        <tr>
            <td>@a.AppointmentDateTime.ToString("dd.MM.yyyy HH:mm")</td>
            <td>@(a.Doctor?.User?.FirstName) @(a.Doctor?.User?.LastName) — @a.Doctor?.Specialization</td>
            <td>@a.Procedure?.Name</td>
            <td><span class="status-badge @a.Status.StatusCss()">@a.Status.StatusText()</span></td>
            <td>
                @if (a.MedicalRecord != null){<span style="font-size:.85rem">Диагноз: @a.MedicalRecord.Diagnosis</span>}else{<span class="text-muted">—</span>}
                @if (User.IsInRole("Admin")){<a asp-controller="MedicalRecord" asp-action="Edit" asp-route-appointmentId="@a.Id" class="btn btn-sm btn-outline" style="margin-left:8px;white-space:nowrap">Открыть карту</a>}
            </td>
        </tr>
    }
    @if (Model.Appointments.Count == 0)
    {
        <tr><td colspan="5" class="text-center text-muted">Нет записей</td></tr>
    }
    </tbody></table></div>
    <a href="javascript:history.back()" class="btn btn-outline mt-4">Назад</a>
</div>
