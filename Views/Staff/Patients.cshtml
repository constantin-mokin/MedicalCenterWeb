@model MedicalCenterWeb.Models.PatientsListViewModel
@using MedicalCenterWeb.Models
@{
    ViewData["Title"] = "Управление пациентами";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<div class="card">
    <div class="card-title">Пациенты</div>
    <div class="search-bar no-print">
        <form method="get" style="display:flex;gap:10px;flex:1"><input type="text" name="search" class="form-control" placeholder="Поиск по ФИО или телефону..." value="@Model.Search" /><button type="submit" class="btn btn-outline">Найти</button></form>
        <button class="btn btn-primary" onclick="toggleForm('patientForm')">+ Добавить</button>
    </div>
    <div id="patientForm" style="display:none" class="card mb-4"><h3 style="margin-bottom:16px">Новый пациент</h3><form asp-action="AddPatient" method="post"><div class="grid-2"><div class="form-group"><label>Имя</label><input type="text" name="firstName" class="form-control" required /></div><div class="form-group"><label>Фамилия</label><input type="text" name="lastName" class="form-control" required /></div><div class="form-group"><label>Телефон</label><input type="tel" name="phone" class="form-control" placeholder="+375XXXXXXXXX" required /></div><div class="form-group"><label>Email</label><input type="email" name="email" class="form-control" /></div><div class="form-group"><label>Дата рождения</label><input type="date" name="dateOfBirth" class="form-control" required /></div><div class="form-group"><label>Пол</label><select name="gender" class="form-control"><option value="Male">Мужской</option><option value="Female">Женский</option></select></div></div><div class="btn-group mt-4"><button type="submit" class="btn btn-success">Сохранить</button><button type="button" class="btn btn-danger" onclick="toggleForm('patientForm')">Отмена</button></div></form></div>
    <div class="table-wrap"><table><thead><tr><th>ФИО</th><th>Телефон</th><th>Email</th><th>Дата рождения</th><th>Пол</th><th>Действия</th></tr></thead><tbody>
    @foreach (var p in Model.Patients)
    {
        <tr><td class="fw-600"><a asp-action="PatientHistory" asp-route-id="@p.Id" style="color:var(--primary);text-decoration:none">@p.FirstName @p.LastName</a></td><td>@p.Phone</td><td>@p.Email</td><td>@p.DateOfBirth.ToString("dd.MM.yyyy")</td><td>@(p.Gender == Gender.Male ? "Муж." : "Жен.")</td><td><div class="btn-group"><a asp-action="PatientHistory" asp-route-id="@p.Id" class="btn btn-sm btn-outline">История</a><button class="btn btn-sm btn-primary" onclick="editPatient(@p.Id,'@p.FirstName','@p.LastName','@p.Phone','@(p.Email ?? "")','@p.DateOfBirth.ToString("yyyy-MM-dd")','@p.Gender')">Изменить</button><form asp-action="DeletePatient" asp-route-id="@p.Id" method="post" onsubmit="return confirm('Удалить пациента @p.FirstName @p.LastName?')"><button type="submit" class="btn btn-sm btn-danger">Удалить</button></form></div></td></tr>
    }
    </tbody></table></div>
    @if (Model.TotalPages > 1)
    {
        <div class="pagination">@{for (var i = 1; i <= Model.TotalPages; i++){ if (i == Model.CurrentPage){<span class="active">@i</span>}else{<a href="?page=@i&search=@Model.Search">@i</a>} }}</div>
    }
</div>
<div id="editModal" class="modal-overlay" style="display:none" onclick="if(event.target===this)this.style.display='none'"><div class="modal"><h2>Редактирование пациента</h2><form asp-action="UpdatePatient" method="post"><input type="hidden" id="editId" name="id" /><div class="grid-2"><div class="form-group"><label>Имя</label><input type="text" id="editFN" name="firstName" class="form-control" required /></div><div class="form-group"><label>Фамилия</label><input type="text" id="editLN" name="lastName" class="form-control" required /></div><div class="form-group"><label>Телефон</label><input type="tel" id="editPh" name="phone" class="form-control" required /></div><div class="form-group"><label>Email</label><input type="email" id="editEm" name="email" class="form-control" /></div><div class="form-group"><label>Дата рождения</label><input type="date" id="editDob" name="dateOfBirth" class="form-control" required /></div><div class="form-group"><label>Пол</label><select id="editG" name="gender" class="form-control"><option value="Male">Мужской</option><option value="Female">Женский</option></select></div></div><div class="btn-group mt-4"><button type="submit" class="btn btn-success">Сохранить</button><button type="button" class="btn btn-danger" onclick="document.getElementById('editModal').style.display='none'">Отмена</button></div></form></div></div>
@section Scripts{<script>function editPatient(id,fn,ln,ph,em,dob,g){document.getElementById('editId').value=id;document.getElementById('editFN').value=fn;document.getElementById('editLN').value=ln;document.getElementById('editPh').value=ph;document.getElementById('editEm').value=em;document.getElementById('editDob').value=dob;document.getElementById('editG').value=g;document.getElementById('editModal').style.display='flex'}</script>}
