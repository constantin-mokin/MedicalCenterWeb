@model MedicalCenterWeb.Models.ProceduresListViewModel
@{
    ViewData["Title"] = "Управление процедурами";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<div class="card">
    <div class="card-title">Процедуры</div>
    <div class="search-bar no-print">
        <form method="get" style="display:flex;gap:10px;flex:1"><input type="text" name="search" class="form-control" placeholder="Поиск процедур..." value="@Model.Search" /><button type="submit" class="btn btn-outline">Найти</button></form>
        <button class="btn btn-primary" onclick="toggleForm('procForm')">+ Добавить</button>
    </div>
    <div id="procForm" style="display:none" class="card mb-4"><h3 style="margin-bottom:16px">Новая процедура</h3><form asp-action="AddProcedure" method="post"><div class="grid-2"><div class="form-group"><label>Название</label><input type="text" name="name" class="form-control" required /></div><div class="form-group"><label>Цена (BYN)</label><input type="number" name="price" class="form-control" value="0" min="1" step="0.01" required /></div><div class="form-group"><label>Длительность (мин.)</label><input type="number" name="durationMinutes" class="form-control" value="30" min="5" /></div><div class="form-group"><label>Описание</label><input type="text" name="description" class="form-control" required /></div></div><div class="btn-group mt-4"><button type="submit" class="btn btn-success">Сохранить</button><button type="button" class="btn btn-danger" onclick="toggleForm('procForm')">Отмена</button></div></form></div>
    <div class="table-wrap"><table><thead><tr><th>Название</th><th>Описание</th><th>Цена</th><th>Длительность</th><th>Действия</th></tr></thead><tbody>
    @foreach (var p in Model.Procedures)
    {
        <tr><td class="fw-600">@p.Name</td><td>@p.Description</td><td>@p.Price.ToString("N2") BYN</td><td>@p.DurationMinutes мин.</td><td><div class="btn-group"><button class="btn btn-sm btn-primary" onclick="editProc(@p.Id,'@p.Name','@p.Description',@p.Price,@p.DurationMinutes)">Изменить</button><form asp-action="DeleteProcedure" asp-route-id="@p.Id" method="post" onsubmit="return confirm('Удалить &quot;@p.Name&quot;?')"><button type="submit" class="btn btn-sm btn-danger">Удалить</button></form></div></td></tr>
    }
    </tbody></table></div>
    @if (Model.TotalPages > 1)
    {
        <div class="pagination">@{for (var i = 1; i <= Model.TotalPages; i++){ if (i == Model.CurrentPage){<span class="active">@i</span>}else{<a href="?page=@i&search=@Model.Search">@i</a>} }}</div>
    }
</div>
<div id="editModal" class="modal-overlay" style="display:none" onclick="if(event.target===this)this.style.display='none'"><div class="modal"><h2>Редактирование процедуры</h2><form asp-action="UpdateProcedure" method="post"><input type="hidden" id="editId" name="id" /><div class="form-group"><label>Название</label><input type="text" id="editName" name="name" class="form-control" required /></div><div class="form-group"><label>Описание</label><input type="text" id="editDesc" name="description" class="form-control" required /></div><div class="form-group"><label>Цена (BYN)</label><input type="number" id="editPrice" name="price" class="form-control" min="1" step="0.01" required /></div><div class="form-group"><label>Длительность</label><input type="number" id="editDur" name="durationMinutes" class="form-control" min="5" /></div><div class="btn-group mt-4"><button type="submit" class="btn btn-success">Сохранить</button><button type="button" class="btn btn-danger" onclick="document.getElementById('editModal').style.display='none'">Отмена</button></div></form></div></div>
@section Scripts{<script>function editProc(id,name,desc,price,dur){document.getElementById('editId').value=id;document.getElementById('editName').value=name;document.getElementById('editDesc').value=desc;document.getElementById('editPrice').value=price;document.getElementById('editDur').value=dur;document.getElementById('editModal').style.display='flex'}</script>}
