@model MedicalCenterWeb.Models.DoctorsListViewModel
@{
    ViewData["Title"] = "Управление врачами";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<div class="card">
    <div class="card-title">Врачи</div>
    <div class="search-bar no-print">
        <form method="get" style="display:flex;gap:10px;flex:1"><input type="text" name="search" class="form-control" placeholder="Поиск по имени, специализации..." value="@Model.Search" /><button type="submit" class="btn btn-outline">Найти</button></form>
        <button class="btn btn-primary" onclick="toggleForm('doctorForm')">+ Добавить</button>
    </div>
    <div id="doctorForm" style="display:none" class="card mb-4">
        <h3 style="margin-bottom:16px">Новый врач</h3>
        <form asp-action="AddDoctor" method="post"><div class="grid-2">
            <div class="form-group"><label>Имя</label><input type="text" name="firstName" class="form-control" required /></div>
            <div class="form-group"><label>Фамилия</label><input type="text" name="lastName" class="form-control" required /></div>
            <div class="form-group"><label>Телефон</label><input type="tel" name="phone" class="form-control" placeholder="+375XXXXXXXXX" required /></div>
            <div class="form-group"><label>Email</label><input type="email" name="email" class="form-control" required /></div>
            <div class="form-group"><label>Специализация</label><input type="text" name="specialization" class="form-control" required /></div>
            <div class="form-group"><label>Стаж (лет)</label><input type="number" name="yearsOfExperience" class="form-control" value="0" min="0" /></div>
        </div><div class="btn-group mt-4"><button type="submit" class="btn btn-success">Сохранить</button><button type="button" class="btn btn-danger" onclick="toggleForm('doctorForm')">Отмена</button></div></form>
    </div>
    <div class="table-wrap"><table><thead><tr><th>Имя</th><th>Специализация</th><th>Стаж</th><th>Телефон</th><th>Email</th><th>Действия</th></tr></thead><tbody>
    @foreach (var d in Model.Doctors)
    {
        <tr>
            <td class="fw-600">@(d.User?.FirstName) @(d.User?.LastName)</td>
            <td>@d.Specialization</td>
            <td>@d.YearsOfExperience лет</td>
            <td>@d.User?.Phone</td>
            <td>@d.User?.Email</td>
            <td><div class="btn-group"><button class="btn btn-sm btn-primary" onclick="editDoctor(@d.Id,'@d.User?.FirstName','@d.User?.LastName','@d.User?.Phone','@d.User?.Email','@d.Specialization',@d.YearsOfExperience)">Изменить</button><form asp-action="DeleteDoctor" asp-route-id="@d.Id" method="post" onsubmit="return confirm('Удалить врача @(d.User?.FirstName) @(d.User?.LastName)?')"><button type="submit" class="btn btn-sm btn-danger">Удалить</button></form></div></td>
        </tr>
    }
    </tbody></table></div>
    @if (Model.TotalPages > 1)
    {
        <div class="pagination">@{for (var i = 1; i <= Model.TotalPages; i++){ if (i == Model.CurrentPage){<span class="active">@i</span>}else{<a href="?page=@i&search=@Model.Search">@i</a>} }}</div>
    }
</div>
<div id="editModal" class="modal-overlay" style="display:none" onclick="if(event.target===this)this.style.display='none'"><div class="modal"><h2>Редактирование врача</h2><form asp-action="UpdateDoctor" method="post"><input type="hidden" id="editId" name="id" /><div class="form-group"><label>Имя</label><input type="text" id="editFirstName" name="firstName" class="form-control" required /></div><div class="form-group"><label>Фамилия</label><input type="text" id="editLastName" name="lastName" class="form-control" required /></div><div class="form-group"><label>Телефон</label><input type="tel" id="editPhone" name="phone" class="form-control" required /></div><div class="form-group"><label>Email</label><input type="email" id="editEmail" name="email" class="form-control" required /></div><div class="form-group"><label>Специализация</label><input type="text" id="editSpec" name="specialization" class="form-control" required /></div><div class="form-group"><label>Стаж</label><input type="number" id="editExp" name="yearsOfExperience" class="form-control" min="0" /></div><div class="btn-group mt-4"><button type="submit" class="btn btn-success">Сохранить</button><button type="button" class="btn btn-danger" onclick="document.getElementById('editModal').style.display='none'">Отмена</button></div></form></div></div>
@section Scripts{<script>function editDoctor(id,fn,ln,ph,em,sp,exp){document.getElementById('editId').value=id;document.getElementById('editFirstName').value=fn;document.getElementById('editLastName').value=ln;document.getElementById('editPhone').value=ph;document.getElementById('editEmail').value=em;document.getElementById('editSpec').value=sp;document.getElementById('editExp').value=exp;document.getElementById('editModal').style.display='flex'}</script>}
