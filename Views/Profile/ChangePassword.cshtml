@{
    ViewData["Title"] = "Смена пароля";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<div class="login-page"><div class="login-card">
    <h1 style="font-size:1.5rem">Смена пароля</h1>
    <p class="subtitle">Укажите текущий и новый пароль</p>
    <p class="text-muted" style="font-size:.85rem">Минимум 8 символов, заглавные и строчные буквы и хотя бы одна цифра.</p>
    <div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div>
    <form method="post" asp-action="ChangePassword">
        <div class="form-group"><label>Текущий пароль</label><input type="password" name="currentPassword" class="form-control" required /></div>
        <div class="form-group"><label>Новый пароль</label><input type="password" name="newPassword" class="form-control" minlength="8" required /></div>
        <div class="form-group"><label>Подтверждение</label><input type="password" name="confirmPassword" class="form-control" minlength="8" required /></div>
        <button type="submit" class="btn btn-primary" style="width:100%;padding:12px">Сменить пароль</button>
        <a href="javascript:history.back()" class="btn btn-outline mt-4" style="width:100%;text-align:center">Назад</a>
    </form>
</div></div>
