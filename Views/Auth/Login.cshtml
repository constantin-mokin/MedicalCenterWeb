@using MedicalCenterWeb.Services
@{
    ViewData["Title"] = Strings.LoginTitle;
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<div class="login-page">
    <div class="login-card">
        <h1>@Strings.AppName</h1>
        <p class="subtitle">@Strings.AppSubtitle</p>
        <div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div>
        <form method="post" asp-action="Login">
            <div class="form-group"><label for="username">@Strings.LoginUsername</label><input type="text" id="username" name="username" class="form-control" placeholder="Введите логин" required autofocus /></div>
            <div class="form-group"><label for="password">@Strings.LoginPassword</label><input type="password" id="password" name="password" class="form-control" placeholder="Введите пароль" required /></div>
            <button type="submit" class="btn btn-primary" style="width:100%;padding:12px;font-size:1rem">@Strings.LoginButton</button>
        </form>
    </div>
</div>
